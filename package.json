{
  "name": "the-haunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:audio",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "e2e:sound": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/sound.mjs",
    "check:audio": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-audio.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.10.2",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
