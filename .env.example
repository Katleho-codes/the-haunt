# Future server-side integrations (not required for the current local-first prototype)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/the_haunt"
REDIS_URL="redis://localhost:6379"
AI_EXTRACTION_API_KEY=""

# Docker: shared secret between haunt-web and the hidden haunt-api container. Required whenever haunt-api runs
# (docker-compose.yml with --profile backend, or the homelab snippet in deploy/homelab/). The API refuses to start without it.
# Server-side only. Never prefix it with NEXT_PUBLIC_. Generate one, for example:
#   PowerShell:  -join (1..48 | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
#   Linux/macOS: openssl rand -hex 32
API_TOKEN=""
